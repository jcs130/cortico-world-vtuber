+"""Exercise the installed splitter without importing torch or loading weights."""
+import ast
+from pathlib import Path
+import re
+import types
+import unittest
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[3] / 'src'))
+
+
+class BoundaryTests(unittest.TestCase):
+    def setUp(self):
+        path = Path(__file__).resolve().parents[3] / 'src/indextts/infer_v2_5.py'
+        tree = ast.parse(path.read_text('utf-8'))
+        cls = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == 'IndexTTS2')
+        cls.body = [node for node in cls.body if (
+            isinstance(node, ast.FunctionDef) and node.name in (
+                'split_text_by_tokens', '_token_chunks', '_split_atomic_pieces')) or (
+            isinstance(node, ast.Assign) and any(isinstance(target, ast.Name) and
+                target.id == 'SPLIT_PROTECTED_PATTERN' for target in node.targets))]
+        module = ast.Module(body=[cls], type_ignores=[])
+        namespace = {'re': re}
+        exec(compile(module, str(path), 'exec'), namespace)
+        self.model = namespace['IndexTTS2'].__new__(namespace['IndexTTS2'])
+        self.model.gpt = types.SimpleNamespace(text_pos_embedding=types.SimpleNamespace(
+            emb=types.SimpleNamespace(num_embeddings=100)))
+        self.model._token_len = len
+
+    def test_stream_budget_keeps_the_whole_word_at_a_clause_end(self):
+        text = '今天我们去村庄看看。先带上面包和火把，再看看有没有需要帮助的朋友。'
+        parts = self.model.split_text_by_tokens(text, 9, prefer_clause_boundaries=True)
+        self.assertEqual(''.join(parts), text)
+        self.assertEqual(parts[0], '今天我们去村庄看看。')
+        self.assertTrue(all(part.endswith(('，', '。')) for part in parts))
+
+    def test_punctuation_is_a_boundary_even_when_the_whole_text_fits_the_budget(self):
+        text = '种子已经收好了，接下来把小麦种下去。等成熟以后再收。'
+        self.assertEqual(self.model.split_text_by_tokens(text, 120, prefer_clause_boundaries=True),
+                         ['种子已经收好了，', '接下来把小麦种下去。', '等成熟以后再收。'])
+
+    def test_stream_quotes_remain_with_the_preceding_clause(self):
+        text = '她说：“小麦种子收好了！” 接下来先去播种。'
+        self.assertEqual(self.model.split_text_by_tokens(text, 24, prefer_clause_boundaries=True),
+                         ['她说：“小麦种子收好了！” ', '接下来先去播种。'])
+
+    def test_stream_preserves_phonetic_atoms_and_decimal_numbers(self):
+        hint = '<|SPECIAL_TOKEN_2|>ZHANG3<|SPECIAL_TOKEN_2|>'
+        text = '田里的麦子' + hint + '大了，距离还有12.5格。'
+        parts = self.model.split_text_by_tokens(text, 16, prefer_clause_boundaries=True)
+        self.assertEqual(parts, ['田里的麦子' + hint + '大了，', '距离还有12.5格。'])
+
+    def test_short_greeting_keeps_the_following_complete_clause_for_playback_runway(self):
+        hint = '<|SPECIAL_TOKEN_2|>HAO3<|SPECIAL_TOKEN_2|>'
+        text = '大家' + hint + '，今天我们去村庄看看。先带上火把。'
+        parts = self.model.split_text_by_tokens(text, 24, prefer_clause_boundaries=True)
+        self.assertEqual(parts[0], '大家' + hint + '，今天我们去村庄看看。')
+        self.assertEqual(''.join(parts), text)
+
+    def test_short_prefix_never_overflows_the_model_position_limit(self):
+        text = '好，' + '麦' * 97 + '。'
+        parts = self.model.split_text_by_tokens(text, 24, prefer_clause_boundaries=True)
+        self.assertEqual(''.join(parts), text)
+        self.assertTrue(all(len(part) <= 98 for part in parts))
+
+    def test_nonstream_budget_retains_existing_token_split_behavior(self):
+        text = '今天我们去村庄看看。先带上面包和火把。'
+        parts = self.model.split_text_by_tokens(text, 9)
+        self.assertEqual(''.join(parts), text)
+        self.assertTrue(all(len(part) <= 9 for part in parts))
+
+    def test_overcapacity_clause_still_respects_the_model_position_limit(self):
+        text = '麦' * 205 + '。'
+        parts = self.model.split_text_by_tokens(text, 24, prefer_clause_boundaries=True)
+        self.assertEqual(''.join(parts), text)
+        self.assertTrue(all(len(part) <= 98 for part in parts))
+
+
+if __name__ == '__main__':
+    unittest.main()
